# Local development only. Change this password; use URL-safe letters and digits.
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=repopilot
# Used inside Docker Compose. Must match the PostgreSQL values above.
APP_DATABASE_URL=postgresql+asyncpg://repopilot:change_this_local_password@postgres:5432/repopilot
APP_DATABASE_TIMEOUT_SECONDS=3
# Host frontend development only; Compose serves the built app through nginx.
API_PROXY_TARGET=http://127.0.0.1:8000

# Authentication: no trailing slash on the origin. Must match the browser address.
APP_ENVIRONMENT=development
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_COOKIE_SECURE=false
APP_SESSION_LIFETIME_HOURS=24

# Redis is internal to Compose; host processes must use 127.0.0.1 instead.
APP_REDIS_URL=redis://redis:6379/0
APP_IMPORT_DOWNLOAD_BYTES=10485760
APP_IMPORT_TIMEOUT_SECONDS=90

# Static indexing worker deadline (10–120 seconds, default 90).
APP_INDEX_TIMEOUT_SECONDS=90

# Optional semantic search. Keyword/symbol search is free and works with these defaults.
# Enabling and preparing semantic search sends source text to OpenAI and can incur charges.
APP_EMBEDDINGS_ENABLED=false
APP_OPENAI_API_KEY=
APP_EMBEDDING_TOKEN_BUDGET=200000
# USD per million input tokens; configurable estimate, not a billing guarantee.
APP_EMBEDDING_PRICE_PER_MILLION=0.02

# Grounded Q&A is independent of semantic embeddings; keyword retrieval can feed it.
# When enabled, answering sends your question, selected conversation turns, and
# retrieved code to OpenAI (paid). Temporary questions do not include history.
APP_ANSWERS_ENABLED=false
APP_ANSWER_MODEL=gpt-4.1-mini-2025-04-14
APP_ANSWER_MAX_OUTPUT_TOKENS=1200
APP_ANSWER_DAILY_REQUEST_LIMIT=100
# Configurable USD estimates; update both when changing models. Not billing guarantees.
# Background-run receipts freeze these rates per call; historical receipts do not change.
APP_ANSWER_INPUT_PRICE_PER_MILLION=0.40
APP_ANSWER_OUTPUT_PRICE_PER_MILLION=1.60

# Read-only investigations: up to five paid model calls per run; keyword tools only.
# Uses the configured answer model, token cap and per-million prices above.
APP_AGENTS_ENABLED=false
APP_AGENT_DAILY_REQUEST_LIMIT=20
